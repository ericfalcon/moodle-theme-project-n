{{!
    Project N course dashboard, separated by the user's role in each course.
    Course pages retain Moodle's native access checks and functionality.
}}
<div class="projectn-course-dashboard">
    {{#hasupcomingactions}}
        <section class="projectn-upcoming-actions" aria-labelledby="projectn-upcoming-actions-title">
            <div class="projectn-learner-dashboard__header">
                <div>
                    <h2 id="projectn-upcoming-actions-title">{{upcomingactionsheading}}</h2>
                    <p class="projectn-learner-dashboard__description">{{upcomingactionsdescription}}</p>
                </div>
            </div>
            <ul class="projectn-upcoming-actions__list">
                {{#upcomingactions}}
                    <li class="projectn-upcoming-actions__item">
                        <div class="projectn-upcoming-actions__details">
                            <p class="projectn-course-card__eyebrow">{{coursename}}</p>
                            <strong>{{name}}</strong>
                            <time datetime="{{datetime}}">{{date}}</time>
                        </div>
                        {{#hasurl}}
                            <a class="projectn-course-card__action" href="{{url}}">{{actionlabel}}</a>
                        {{/hasurl}}
                        {{^hasurl}}
                            <span class="projectn-upcoming-actions__unavailable">{{actionlabel}}</span>
                        {{/hasurl}}
                    </li>
                {{/upcomingactions}}
            </ul>
        </section>
    {{/hasupcomingactions}}

    {{#haslearnercourses}}
        <section class="projectn-learner-dashboard" aria-labelledby="projectn-learner-dashboard-title">
            <div class="projectn-learner-dashboard__header">
                <div>
                    <h2 id="projectn-learner-dashboard-title">{{learnerheading}}</h2>
                    <p class="projectn-learner-dashboard__description">{{learnerdescription}}</p>
                </div>
                <a class="projectn-learner-dashboard__more" href="{{moreurl}}">{{morelabel}}</a>
            </div>
            <ul class="projectn-course-grid">
                {{#learnercourses}}
                    <li class="projectn-course-card">
                        <div class="projectn-course-card__body">
                            <p class="projectn-course-card__eyebrow">{{shortname}}</p>
                            <h3 class="projectn-course-card__title"><a href="{{url}}">{{fullname}}</a></h3>
                            {{#hasprogress}}
                                <div class="projectn-course-card__progress">
                                    <div class="projectn-course-card__progress-label">{{progresslabel}}</div>
                                    <progress max="100" value="{{progresspercent}}" aria-label="{{progresslabel}}">{{progresspercent}}%</progress>
                                </div>
                            {{/hasprogress}}
                            {{#hasnextactivity}}
                                <a class="projectn-course-card__next" href="{{nextactivityurl}}">
                                    <span>{{nextactivitylabel}}</span>
                                    <strong>{{nextactivityname}}</strong>
                                </a>
                            {{/hasnextactivity}}
                            <a class="projectn-course-card__action" href="{{url}}">{{morelabel}}</a>
                        </div>
                    </li>
                {{/learnercourses}}
            </ul>
        </section>
    {{/haslearnercourses}}

    {{#hasteachercourses}}
        <section class="projectn-learner-dashboard projectn-teacher-dashboard" aria-labelledby="projectn-teacher-dashboard-title">
            <div class="projectn-learner-dashboard__header">
                <div>
                    <h2 id="projectn-teacher-dashboard-title">{{teacherheading}}</h2>
                    <p class="projectn-learner-dashboard__description">{{teacherdescription}}</p>
                </div>
                <a class="projectn-learner-dashboard__more" href="{{moreurl}}">{{morelabel}}</a>
            </div>
            <ul class="projectn-course-grid">
                {{#teachercourses}}
                    <li class="projectn-course-card">
                        <div class="projectn-course-card__body">
                            <p class="projectn-course-card__eyebrow">{{shortname}}</p>
                            <h3 class="projectn-course-card__title"><a href="{{url}}">{{fullname}}</a></h3>
                            <a class="projectn-course-card__action" href="{{url}}">{{morelabel}}</a>
                        </div>
                    </li>
                {{/teachercourses}}
            </ul>
        </section>
    {{/hasteachercourses}}

    {{^hasanycourses}}
        <section class="projectn-learner-dashboard" aria-labelledby="projectn-learner-dashboard-title">
            <h2 id="projectn-learner-dashboard-title">{{learnerheading}}</h2>
            <div class="projectn-learner-dashboard__empty">
                <h3>{{emptytitle}}</h3>
                <p>{{emptydescription}}</p>
            </div>
        </section>
    {{/hasanycourses}}
</div>
